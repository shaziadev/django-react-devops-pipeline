# Template for /opt/app/.env on the EC2 server (production).
# For staging, use the same keys with DJANGO_ENV=staging and the staging domain.

DJANGO_ENV=production
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
DOMAIN=app.example.com

# Images: set by deploy.sh on each release (TAG = git commit SHA).
IMAGE_PREFIX=ghcr.io/shaziadev/django-react-devops-pipeline
TAG=latest

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=use-a-strong-password
POSTGRES_PORT=5432

# Email used for Let's Encrypt expiry notices.
LETSENCRYPT_EMAIL=you@example.com
